{
  "browserslist": {
    "production": [
      "last 2 chrome version",
      "last 2 firefox version"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version"
    ]
  },
  "dependencies": {    
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "7.5.2"
  },
  "devDependencies": {    
    "parcel": "2.13.3",
    "process": "0.11.10",
    "rimraf": "6.0.1"
  },
  "private": true,
  "scripts": {        
    "prestart": "rimraf ../wwwroot/",
    "start": "parcel watch src/index.html --no-cache --dist-dir ../wwwroot",
    "prebuild": "rimraf ../wwwroot/",
    "build": "parcel build src/index.html --no-cache --dist-dir ../wwwroot"
  },
  "source": "src/index.html",
  "targets": {
    "default": {
      "distDir": "../wwwroot"
    }
  },
  "type": "module",
  "version": "2025.3.11",
  "name": "miniredmine-react"
}
